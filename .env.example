# 复制为 .env 后填写。.env 已被 .gitignore 排除，不会误提交。
#
# 说明：本工具箱**没有任何内置兜底口令**。缺失必填项时会直接报错并提示怎么配，
# 而不是悄悄用一个默认值连上去——明文的默认口令正是这类脚本最容易出事的地方。
#
# 另外：「选填」段落里的值是**占位示例**，与任何真实环境无关。容器名与容器内路径
# 在不同部署里差别很大，请务必换成自己的实际值。

# ---- 必填 ----
# 目标机地址（内网环境请填写实际 IP）
TG_HOST=192.168.0.100
# SSH 口令
TG_SSH_PASSWORD=change-me

# ---- 选填（默认值是占位示例，通常都需要你改）----
# SSH 用户名，示例值 deploy
TG_SSH_USER=deploy
# SSH 端口，默认 22
TG_SSH_PORT=22
# sudo 口令。留空则沿用 SSH 口令；若该机免密 sudo，请显式设为空字符串
# TG_SUDO_PASSWORD=
# Docker 容器名，示例值 webapp
TG_CONTAINER=webapp
# 容器内的前端构建产物目录，示例值 /opt/webapp/web/dist/assets
TG_ASSETS=/opt/webapp/web/dist/assets
# 前端 HTTP 端口，示例值 8080
TG_HTTP_PORT=8080

# ---- 浏览器端到端（验证步骤用）----
# 不填则自动探测常见安装路径
# TG_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe
